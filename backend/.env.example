# Nexonix backend environment example
#
# New developer setup:
# 1. Copy this file to .env in the backend directory.
# 2. Replace the example values with your local settings. Never commit .env.
# 3. Install dependencies with `npm install`, then start the API with `npm run dev`.
# 4. To create the configured admin user, run `npm run admin` after MongoDB is available.
#
# Keep credentials private. Use a unique JWT secret for each environment, and do not
# share real secrets in source control, chat, screenshots, or issue trackers.

# MongoDB connection string. Local development example; use your assigned Atlas URI
# if the team has provided a shared development database.
MONGO_URI=mongodb://127.0.0.1:27017/nexonix

# Email address used by the admin bootstrap script to create the initial admin account.
ADMIN_EMAIL=admin@example.com

# Secret used to sign and verify authentication tokens. Replace with a long,
# randomly generated value before running the application.
JWT_SECRET=replace-with-a-long-random-secret

# Token lifetime accepted by jsonwebtoken (for example: 10d, 12h, or 30m).
JWT_EXPIRES_IN=10d

# API server port. Optional; the application defaults to 5000 when omitted.
PORT=5000

# Security note: the current admin bootstrap script contains a hard-coded starter
# password. Change the admin password immediately after creating the account.