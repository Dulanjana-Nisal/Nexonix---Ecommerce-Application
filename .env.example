# Docker compose environment variables list

# mongodb
MONGO_INITDB_ROOT_USERNAME=add_roo_username_here
MONGO_INITDB_ROOT_PASSWORD=add_root_password_here

# mongo-express
ME_CONFIG_MONGODB_ADMINUSERNAME=add_config_mongodb_admin_username_here
ME_CONFIG_MONGODB_ADMINPASSWORD=add_config_mongodb_admin_password_here
ME_CONFIG_BASICAUTH_USERNAME=add_config_basic_auth_username_here
ME_CONFIG_BASICAUTH_PASSWORD=add_config_basic_auth_password_here